/# Foundereum Production Environment
# Copy to .env on the production VM

# ─── Postgres ───────────────────────────────────────────
POSTGRES_USER=fnd
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=foundereum

# ─── App ────────────────────────────────────────────────
ENV=production
LOG_LEVEL=info

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ─── Privy ──────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
PRIVY_AUTH_KEY=
QUORUM_MODE=privy

# ─── Hedera Testnet ────────────────────────────────────
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT=
HEDERA_OPERATOR_KEY=
HEDERA_PLATFORM_ACCOUNT=
HEDERA_FAUCET_ACCOUNT=
HEDERA_FAUCET_KEY=
HEDERA_FEEPAYER_ACCOUNT=
HEDERA_FEEPAYER_KEY=
HEDERA_USDC_TOKEN_ID=0.0.429274
HEDERA_JSON_RPC=https://testnet.hashio.io/api
HEDERA_EVM_CHAIN_ID=296
HEDERA_AUDIT_TOPIC_ID=

# ─── The Graph ──────────────────────────────────────────
GRAPH_API_KEY=

# ─── DeFi ───────────────────────────────────────────────
SAUCERSWAP_ROUTER=0x0000000000000000000000000000000000004b40
WHBAR_ADDR=0x0000000000000000000000000000000000003ad2
FACILITATOR_MODE=blocky
BLOCKY402_URL=https://facilitator.blocky402.com
WALLET_SIGNER=privy

# ─── Docker Image Config ───────────────────────────────
IMAGE_PREFIX=ghcr.io/himesh-kundal/foundereum
IMAGE_TAG=latest
