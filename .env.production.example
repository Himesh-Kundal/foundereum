# Foundereum Production Environment Template (foundereum.org)
# Copy to .env.production on your deployment server (NEVER commit the real values!)

# Infrastructure & Domain
DOMAIN=foundereum.org
ENV=production
LOG_LEVEL=info

# Database (PostgreSQL 16)
POSTGRES_USER=fnd
POSTGRES_PASSWORD=
POSTGRES_DB=foundereum
DATABASE_URL=postgres://fnd:YOUR_DB_PASSWORD@postgres:5432/foundereum?sslmode=disable

# Redis 7
REDIS_URL=redis://redis:6379

# Service Ports (Internal container bindings)
PORT_API=8080
PORT_GATEWAY=8081
PORT_MCP=8082

# Authentication & Security
JWT_SECRET=
AUTH_DEV_BYPASS=false
QUORUM_MODE=privy

# Privy (B2B Org, Server Wallets, Policy Engine)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
PRIVY_AUTH_KEY=

# Hedera Production / Testnet Configuration
HEDERA_NETWORK=testnet
HEDERA_PLATFORM_ACCOUNT=
HEDERA_OPERATOR_ACCOUNT=
HEDERA_OPERATOR_KEY=
HEDERA_FAUCET_ACCOUNT=
HEDERA_FAUCET_KEY=
HEDERA_FEEPAYER_ACCOUNT=
HEDERA_FEEPAYER_KEY=
HEDERA_USDC_TOKEN_ID=0.0.429274
HEDERA_JSON_RPC=https://testnet.hashio.io/api
HEDERA_EVM_CHAIN_ID=296

# The Graph
GRAPH_API_KEY=
SUBGRAPH_MCP_URL=http://subgraph-mcp:7000

# Dex & DeFi
SAUCERSWAP_ROUTER=0x0000000000000000000000000000000000000000
WHBAR_ADDR=0x0000000000000000000000000000000000000000

# Facilitator & Signing
FACILITATOR_MODE=blocky
BLOCKY402_URL=https://facilitator.blocky402.com
WALLET_SIGNER=privy
MOCK_CHAINS=false

# Web URLs (Caddy reverse-proxy endpoints)
VITE_API_URL=https://api.foundereum.org
VITE_PRIVY_APP_ID=
